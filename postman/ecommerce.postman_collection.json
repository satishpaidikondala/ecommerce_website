{
  "info": {
    "name": "Ecommerce Microservices - GramSetu",
    "description": "54 APIs via Gateway 8080 — import and set baseUrl, then Register → Login (auto sets token), then run any folder",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "User & Auth",
      "item": [
        {
          "name": "Register",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/users", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Satish\",\n  \"lastName\": \"P\",\n  \"email\": \"test{{$randomInt}}@ecommerce.com\",\n  \"password\": \"Secret123!\",\n  \"phone\": \"9999999999\"\n}" } },
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json(); pm.collectionVariables.set(\"userId\", json.id);"] }}]
        },
        {
          "name": "Login",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/login", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@ecommerce.com\",\n  \"password\": \"Secret123!\"\n}" } },
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json(); pm.collectionVariables.set(\"token\", json.token); pm.collectionVariables.set(\"userId\", json.userId);"] }}]
        },
        { "name": "Get User by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" } },
        { "name": "Get Me", "request": { "method": "GET", "url": "{{baseUrl}}/api/users/me", "header": [{ "key": "X-User-Id", "value": "{{userId}}" }] } },
        { "name": "Update User", "request": { "method": "PUT", "url": "{{baseUrl}}/api/users/{{userId}}", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"firstName\":\"Satish Updated\",\"lastName\":\"P\",\"phone\":\"8888888888\"}" } } },
        { "name": "Update Address", "request": { "method": "PUT", "url": "{{baseUrl}}/api/users/{{userId}}/address", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"address\":\"123 Village\",\"city\":\"Village\",\"state\":\"MP\",\"zipCode\":\"12345\",\"country\":\"India\"}" } } },
        { "name": "Update Password", "request": { "method": "PUT", "url": "{{baseUrl}}/api/users/{{userId}}/password?newPassword=NewSecret123!" } },
        { "name": "Send OTP", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/send-otp?email=test@ecommerce.com" } },
        { "name": "Verify OTP", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/verify-otp?email=test@ecommerce.com&code=123456" } },
        { "name": "Delete User", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/{{userId}}" } }
      ]
    },
    {
      "name": "Product & Category",
      "item": [
        { "name": "Create Category", "request": { "method": "POST", "url": "{{baseUrl}}/api/categories", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Handicrafts\",\"description\":\"Village crafts\",\"imageUrl\":\"http://minio:9001/product-images/cat.jpg\"}" } } },
        { "name": "Get All Categories", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories" } },
        { "name": "Get Category by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/1" } },
        { "name": "Create Product", "request": { "method": "POST", "url": "{{baseUrl}}/api/products", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Desi Ghee\",\"description\":\"Pure\",\"price\":500,\"sku\":\"SKU-GHEE-001\",\"imageUrl\":\"http://minio:9001/product-images/ghee.jpg\",\"unitsInStock\":100,\"categoryId\":1}" } } },
        { "name": "Get Product by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/1" } },
        { "name": "Get All Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products" } },
        { "name": "Search Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products?search=ghee" } },
        { "name": "Filter by Price", "request": { "method": "GET", "url": "{{baseUrl}}/api/products?minPrice=100&maxPrice=1000" } },
        { "name": "Top Rated", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/top-rated" } },
        { "name": "Upload Image", "request": { "method": "POST", "url": "{{baseUrl}}/api/files/upload", "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] } } }
      ]
    },
    {
      "name": "Cart",
      "item": [
        { "name": "Get or Create Cart", "request": { "method": "GET", "url": "{{baseUrl}}/api/carts/user/{{userId}}/or-create" } },
        { "name": "Get Cart", "request": { "method": "GET", "url": "{{baseUrl}}/api/carts/user/{{userId}}" } },
        { "name": "Add Item", "request": { "method": "POST", "url": "{{baseUrl}}/api/carts/1/items", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"productId\":1,\"quantity\":1}" } } },
        { "name": "Update Quantity", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/carts/1/items/1?quantity=3" } },
        { "name": "Get Total", "request": { "method": "GET", "url": "{{baseUrl}}/api/carts/1/total" } },
        { "name": "Clear Cart", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/carts/1/clear" } }
      ]
    },
    {
      "name": "Order & Payment",
      "item": [
        { "name": "Create Order", "request": { "method": "POST", "url": "{{baseUrl}}/api/orders", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"userId\":{{userId}},\"shippingAddress\":\"123 Village\",\"shippingCity\":\"Village\",\"shippingState\":\"MP\",\"shippingZip\":\"12345\",\"shippingCountry\":\"India\"}" } } },
        { "name": "Get Order", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/1" } },
        { "name": "Get Order Items", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/1/items" } },
        { "name": "Get Invoice", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/1/invoice" } },
        { "name": "Cancel Order", "request": { "method": "POST", "url": "{{baseUrl}}/api/orders/1/cancel" } },
        { "name": "Create Payment", "request": { "method": "POST", "url": "{{baseUrl}}/api/payments", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"orderId\":1,\"paymentMethod\":\"UPI\",\"amount\":500}" } } },
        { "name": "Refund Payment", "request": { "method": "POST", "url": "{{baseUrl}}/api/payments/1/refund" } },
        { "name": "Payment Webhook", "request": { "method": "POST", "url": "{{baseUrl}}/api/payments/webhook", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"event\":\"payment.success\",\"orderId\":1}" } } }
      ]
    },
    {
      "name": "Wishlist & Review & Inventory",
      "item": [
        { "name": "Add to Wishlist", "request": { "method": "POST", "url": "{{baseUrl}}/api/wishlist?userId={{userId}}&productId=1" } },
        { "name": "Get Wishlist", "request": { "method": "GET", "url": "{{baseUrl}}/api/wishlist/user/{{userId}}" } },
        { "name": "Add Review", "request": { "method": "POST", "url": "{{baseUrl}}/api/reviews", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"productId\":1,\"userId\":{{userId}},\"rating\":5,\"comment\":\"Excellent!\"}" } } },
        { "name": "Get Reviews by Product", "request": { "method": "GET", "url": "{{baseUrl}}/api/reviews/product/1" } },
        { "name": "Get Average Rating", "request": { "method": "GET", "url": "{{baseUrl}}/api/reviews/product/1/average" } },
        { "name": "Get Stock", "request": { "method": "GET", "url": "{{baseUrl}}/api/inventory/product/1" } },
        { "name": "Update Stock", "request": { "method": "PUT", "url": "{{baseUrl}}/api/inventory/product/1?stock=100" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "Admin Stats", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/stats" } }
      ]
    }
  ]
}
